# ---- Telegram (see docs/setup-telegram.md) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=

# ---- Market data ----
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
# SEC requires a declared contact string or it blocks you
SEC_USER_AGENT=Gabriel Suzuki gabrielsuzuki789@gmail.com

# ---- Claude ----
ANTHROPIC_API_KEY=

# ---- tokenwise cost control (see docs/cost-control.md) ----
# Leave TOKENWISE_LEDGER unset unless you want the ledger somewhere specific.
# It used to be pinned to /opt/screener here, which on Windows silently sent
# the ledger to C:\opt\screener while every reader looked in the repo folder --
# so the spend report said "no model calls recorded" after 21 real API calls.
# TOKENWISE_LEDGER=
TOKENWISE_ENABLED=1
