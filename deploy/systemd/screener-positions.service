[Unit]
Description=Screener — midday position and sell check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=screener
Group=screener
WorkingDirectory=/opt/screener/app
EnvironmentFile=/opt/screener/.env
ExecStart=/opt/screener/venv/bin/python -m pipeline.positions --send
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/screener/data /opt/screener/journal /opt/screener/logs
StandardOutput=append:/opt/screener/logs/positions.log
StandardError=append:/opt/screener/logs/positions.log
