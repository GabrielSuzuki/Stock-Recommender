[Unit]
Description=Screener watchdog — alert if the morning brief never went out
After=network-online.target

[Service]
Type=oneshot
User=screener
Group=screener
WorkingDirectory=/opt/screener/app
EnvironmentFile=/opt/screener/.env
ExecStart=/opt/screener/venv/bin/python -m pipeline.watchdog
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/screener/logs
StandardOutput=append:/opt/screener/logs/watchdog.log
StandardError=append:/opt/screener/logs/watchdog.log
